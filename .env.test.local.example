# Sao chép file này thành .env.test.local và điền credentials test thật

VITE_API_BASE=http://localhost:5000/api

# Credentials cho từng role (phải tồn tại trong DB test)
VITE_TEST_USER_EMAIL=testuser@pbms.vn
VITE_TEST_USER_PASSWORD=Test@1234

VITE_TEST_STAFF_EMAIL=teststaff@pbms.vn
VITE_TEST_STAFF_PASSWORD=Test@1234

VITE_TEST_MANAGER_EMAIL=testmanager@pbms.vn
VITE_TEST_MANAGER_PASSWORD=Test@1234

VITE_TEST_ADMIN_EMAIL=admin@pbms.vn
VITE_TEST_ADMIN_PASSWORD=Admin@1234

# Building ID để test manager/staff endpoints (phải tồn tại trong DB)
VITE_TEST_BUILDING_ID=<mongo_object_id>
